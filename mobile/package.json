{
  "name": "@workspace/vexforge-mobile",
  "version": "1.10.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port ${PORT:-8081}",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:game-runtime": "node --experimental-strip-types scripts/verify-mobile-game-runtime.mjs",
    "audit:battle": "node --experimental-strip-types scripts/audit-battle.ts",
    "audit:economy": "node --experimental-strip-types scripts/audit-economy.ts",
    "audit:all": "npm run verify && npm run audit:tier1 && npm run audit:runtime && npm run audit:release && npm run audit:final && npm run audit:live-economy && npm run audit:battle && npm run audit:interactive && npm run audit:economy && npm run audit:economy-policy && npm run typecheck",
    "doctor": "npx expo-doctor",
    "prebuild": "npx expo prebuild --clean",
    "build:preview": "eas build --platform android --profile preview",
    "build:production": "eas build --platform android --profile production",
    "audit:economy-policy": "node --experimental-strip-types scripts/audit-economy-policy.ts",
    "audit:interactive": "node --experimental-strip-types scripts/audit-interactive.ts",
    "audit:release": "node --experimental-strip-types scripts/audit-release.ts",
    "audit:tier1": "node scripts/audit-tier1-1.10.mjs",
    "audit:runtime": "node scripts/audit-runtime-compat-1.10.mjs",
    "audit:live-economy": "node scripts/audit-live-economy-boundary.mjs",
    "audit:final": "node scripts/audit-final-ship-1.10.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "0.4.2",
    "@expo-google-fonts/inter": "0.4.0",
    "@expo-google-fonts/rajdhani": "0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "2.58.0",
    "@tanstack/react-query": "5.90.21",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "1.1.1",
    "expo-blur": "15.0.8",
    "expo-constants": "18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.12",
    "expo-router": "6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "22.15.29",
    "@types/react": "19.1.10",
    "typescript": "5.9.2"
  }
}
