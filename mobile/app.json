{
  "expo": {
    "name": "VEXFORGE",
    "slug": "vexforge",
    "version": "1.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vexforge-android",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050D"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.vexforge.android",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#05050D"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/",
          "root": "./app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-audio",
      "./plugins/withEmbeddedJsBundle.js",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://rscuzqnfccqvltkdcdny.supabase.co/functions/v1/vexforge-updates",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "supabaseUrl": "https://rscuzqnfccqvltkdcdny.supabase.co"
    }
  }
}
