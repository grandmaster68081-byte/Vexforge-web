{
  "name": "vexforge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:build": "npm run build && node scripts/verify-build.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:identity-data": "node scripts/verify-identity-data.mjs",
    "verify:ui-identity": "node scripts/verify-ui-identity.mjs",
    "verify:all": "npm run typecheck && npm run verify:build && npm run verify:ui-identity && npm run verify:identity-data && npm run verify:boss-art && npm run verify:card-art && npm run verify:surface-art && npm run verify:assets",
    "verify:boss-art": "node scripts/verify-boss-art.mjs",
    "verify:card-art": "node scripts/verify-card-art.mjs",
    "verify:surface-art": "node scripts/verify-surface-art.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
