{
  "name": "vexforge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify:build": "npm run build && node scripts/verify-build.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:auth-guard": "node scripts/verify-auth-guard.mjs",
    "verify:table-docs": "node scripts/verify-table-docs.mjs",
    "verify:column-docs": "node scripts/verify-column-docs.mjs",
    "verify:support-column-docs": "node scripts/verify-support-column-docs.mjs",
    "verify:identity-data": "node scripts/verify-identity-data.mjs",
    "verify:ui-identity": "node scripts/verify-ui-identity.mjs",
    "verify:boss-art": "node scripts/verify-boss-art.mjs",
    "verify:card-art": "node scripts/verify-card-art.mjs",
    "verify:surface-art": "node scripts/verify-surface-art.mjs",
    "verify:residual-art": "node scripts/verify-residual-art.mjs",
    "verify:motion": "node scripts/verify-motion.mjs",
    "verify:combat-scene": "node scripts/verify-combat-scene.mjs",
    "verify:audio-flow": "node scripts/verify-audio-flow.mjs",
    "verify:telemetry": "node scripts/verify-telemetry.mjs",
    "verify:mobile-auth": "node scripts/verify-mobile-auth.mjs",
    "verify:mobile-deck": "node scripts/verify-mobile-deck.mjs",
    "verify:mobile-battle": "node scripts/verify-mobile-battle.mjs",
    "verify:mobile-rewards": "node scripts/verify-mobile-rewards.mjs",
    "verify:mobile-profile": "node scripts/verify-mobile-profile.mjs",
    "verify:mobile-tutorial": "node scripts/verify-mobile-tutorial.mjs",
    "verify:mobile-store": "node scripts/verify-mobile-store.mjs",
    "verify:mobile-economy": "node scripts/verify-mobile-economy.mjs",
    "verify:mobile-world": "node scripts/verify-mobile-world.mjs",
    "verify:mobile-meta": "node scripts/verify-mobile-meta.mjs",
    "verify:all": "npm run typecheck && npm run verify:build && npm run verify:telemetry && npm run verify:motion && npm run verify:combat-scene && npm run verify:audio-flow && npm run verify:ui-identity && npm run verify:identity-data && npm run verify:boss-art && npm run verify:card-art && npm run verify:surface-art && npm run verify:residual-art && npm run verify:manifest && npm run verify:assets && npm run verify:auth-guard && npm run verify:mobile-auth && npm run verify:mobile-deck && npm run verify:mobile-battle && npm run verify:mobile-rewards && npm run verify:mobile-profile && npm run verify:mobile-tutorial && npm run verify:mobile-store && npm run verify:mobile-economy && npm run verify:mobile-world && npm run verify:mobile-meta && npm run verify:table-docs && npm run verify:column-docs && npm run verify:support-column-docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
